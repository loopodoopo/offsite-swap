# Copy to .env and fill in.

# Your name: login and repository name at the other side (lowercase, no spaces).
NAME=alice

# Tunnel addresses. One side uses .1, the other .2.
TUNNEL_IP=10.214.83.1
PEER_TUNNEL_IP=10.214.83.2

# From the other side (./offsite keys prints it there).
PEER_PUBLIC_KEY=
# Their dynamic DNS name and port, like friend.example.org:51820.
# Leave empty if they have no open port.
PEER_ENDPOINT=

# UDP port on this host for WireGuard. Forward it on your router if you can.
WG_PORT=51820

# Where the other side's backup is stored on this host.
STORE_DIR=/tank/offsite

# When to back up and check (cron syntax, local time).
TZ=Europe/Amsterdam
BACKUP_SCHEDULE="0 4 * * *"
CHECK_SCHEDULE="0 12 * * 0"

# Optional: upload limit in KiB/s (12500 is about 100 Mbit/s).
UPLOAD_LIMIT=

# Optional: URLs to call after each run, for example a dead man's switch.
# They must be outside your network: the containers can't reach it.
NOTIFY_OK_URL=
NOTIFY_FAIL_URL=

# Optional: extra rest-server options, for example a size limit without ZFS
# (--max-size 500000000000).
REST_SERVER_OPTIONS=
